# Copy to /etc/ssl/mouzoun/ssl_config.conf once the certificate is installed.
# Recommended: Cloudflare Origin Certificate (15 years, SSL mode "Full (strict)").
listen 443 ssl;
listen [::]:443 ssl;
http2 on;
ssl_certificate     /etc/ssl/mouzoun/origin.pem;
ssl_certificate_key /etc/ssl/mouzoun/origin.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:mouzoun_ssl:10m;
ssl_session_timeout 1d;
