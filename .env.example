# development | test | production. Production refuses unsafe settings (e.g. PAYMENTS_FAKE=true)
# and requires CORS_ORIGINS, PUBLIC_SITE_URL, API_PUBLIC_URL, WEBAUTHN_*, GUEST_DATA_KEY.
APP_ENV=development

APP_HOST=0.0.0.0
APP_PORT=8080
LOG_JSON=false
RUST_LOG=mouzoun_api=debug,tower_http=info,sqlx=warn

DATABASE_URL=postgres://mouzoun:mouzoun@localhost:5433/mouzoun
DATABASE_MAX_CONNECTIONS=20
REDIS_URL=redis://:mouzoun-redis@localhost:6380

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_TTL_MINUTES=720
# Local development runs over plain HTTP: the session cookie cannot be `Secure` (keep true in production)
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3001

# First admin is created at startup if no admin exists
ADMIN_EMAIL=admin@mouzoun.com
ADMIN_PASSWORD=ChangeMe123!

# --- Google Cloud Storage -------------------------------------------------
MEDIA_MAX_UPLOAD_BYTES=15728640
MEDIA_UPLOAD_URL_TTL_SECS=900
MEDIA_DOWNLOAD_URL_TTL_SECS=900
MEDIA_PENDING_TTL_SECS=86400
MEDIA_CLEANUP_INTERVAL_SECS=3600

# --- Transactional emails (docs/email/README.md) ---------------------------
# log = print emails in the API logs. To see real emails locally, use Mailpit (docker compose):
#   EMAIL_PROVIDER=smtp SMTP_HOST=localhost SMTP_TLS=none   → http://localhost:8025
EMAIL_PROVIDER=log
EMAIL_FROM=reservations@mouzoun.com
EMAIL_FROM_NAME=Mouzoun
# EMAIL_REPLY_TO=contact@mouzoun.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# Links in emails point to the website
PUBLIC_SITE_URL=http://localhost:3001

# --- Outbox worker ----------------------------------------------------------
# true: the API dispatches outbox events itself; false: run `cargo run --bin worker`
OUTBOX_WORKER_ENABLED=true
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_SECS=5

# --- Booking and payments (docs/booking/README.md) ---------------------------
# Fake payment provider for local development and tests only: never on a public server.
PAYMENTS_FAKE=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # `stripe listen --forward-to localhost:8080/v1/payments/webhooks/stripe`
# TURNSTILE_SECRET_KEY=                 # Cloudflare Turnstile (checkout, find my booking); empty = off
# Guest ID numbers (pre-check-in) are encrypted with this key: openssl rand -base64 32
# GUEST_DATA_KEY=

# --- Guest accounts (docs/accounts/README.md) -------------------------------
# New passwords are checked against Have I Been Pwned (k-anonymity: only 5 hash characters leave).
HIBP_ENABLED=true
# Public URL of the API as browsers see it (OAuth redirect URIs end in /v1/account/oauth/<provider>/callback).
API_PUBLIC_URL=http://localhost:8080
# Passkeys: relying party id (the site's domain) and exact site origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
# "Continue with Google" (empty = button hidden).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# "Continue with Apple": Services ID, team, key id and the .p8 key (newlines as \n).
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
