# development | test | production. Production refuses unsafe settings (e.g. PAYMENTS_FAKE=true)
# and requires CORS_ORIGINS, PUBLIC_SITE_URL, API_PUBLIC_URL, WEBAUTHN_*, GUEST_DATA_KEY.
APP_ENV=development

APP_HOST=0.0.0.0
APP_PORT=8080
LOG_JSON=false
RUST_LOG=mouzoun_api=debug,tower_http=info,sqlx=warn

DATABASE_URL=postgres://mouzoun:mouzoun@localhost:5433/mouzoun
DATABASE_MAX_CONNECTIONS=20
# Apply pending migrations at startup (false: run `cargo run --bin migrations` yourself)
DATABASE_RUN_MIGRATIONS=true
REDIS_URL=redis://:mouzoun-redis@localhost:6380

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_TTL_MINUTES=720
# Local development runs over plain HTTP: the session cookie cannot be `Secure` (keep true in production)
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:3001
# Behind nginx: take the client IP from X-Forwarded-For (rate limits, audit)
TRUST_PROXY=true

# First admin is created at startup if no admin exists
ADMIN_EMAIL=admin@mouzoun.com
ADMIN_PASSWORD=ChangeMe123!

# --- Google Cloud Storage -------------------------------------------------
# One bucket, ACL per object (docs/media). Required: the API does not start without the bucket.
GCS_BUCKET_NAME=
# Service account key (empty: Application Default Credentials)
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY_ID=
GCS_PRIVATE_KEY=
# Empty: https://storage.googleapis.com/<bucket>
GCS_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_DOWNLOAD_URL_TTL_SECS=900

# --- Transactional emails (docs/email/README.md) ---------------------------
# log = print emails in the API logs. To see real emails locally, use Mailpit (docker compose):
#   EMAIL_PROVIDER=smtp SMTP_HOST=localhost SMTP_TLS=none   → http://localhost:8025
EMAIL_PROVIDER=log
EMAIL_FROM=reservations@mouzoun.com
EMAIL_FROM_NAME=Mouzoun
# EMAIL_REPLY_TO=contact@mouzoun.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# Links in emails point to the website
PUBLIC_SITE_URL=http://localhost:3001

# --- Outbox worker ----------------------------------------------------------
# true: the API dispatches outbox events itself; false: run `cargo run --bin worker`
OUTBOX_WORKER_ENABLED=true
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_SECS=5
OUTBOX_SCHEDULER_SECS=300

# --- Booking and payments (docs/booking/README.md) ---------------------------
# Fake payment provider for local development and tests only: never on a public server.
PAYMENTS_FAKE=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # `stripe listen --forward-to localhost:8080/v1/payments/webhooks/stripe`
# STRIPE_API_BASE=https://api.stripe.com  # tests point it at a mock
# TURNSTILE_SECRET_KEY=                 # Cloudflare Turnstile (checkout, sign-in, find my booking); empty = off
# TURNSTILE_SITE_KEY=                   # its public key, served to the site; set both or none
# Guest ID numbers (pre-check-in) are encrypted with this key: openssl rand -base64 32
# GUEST_DATA_KEY=

# --- Guest accounts (docs/accounts/README.md) -------------------------------
# New passwords are checked against Have I Been Pwned (k-anonymity: only 5 hash characters leave).
HIBP_ENABLED=true
# Public URL of the API as browsers see it (OAuth redirect URIs end in /v1/account/oauth/<provider>/callback).
API_PUBLIC_URL=http://localhost:8080
# Passkeys: relying party id (the site's domain) and exact site origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
# "Continue with Google" (empty = button hidden).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# "Continue with Apple": Services ID, team, key id and the .p8 key (newlines as \n).
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Machine translation of admin content ("Générer" buttons): Google Translate's free public
# endpoint, no key (unofficial, may rate-limit). Set TRANSLATE_ENABLED=false to turn it off.
TRANSLATE_ENABLED=true
# TRANSLATE_API_BASE=https://translate.googleapis.com

# PayPal: read by the config, not used by any feature yet.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox

# --- seed_dev only ------------------------------------------------------------
# Admin of the demo data (empty: ADMIN_EMAIL / ADMIN_PASSWORD); photo blur-ups manifest.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_PHOTOS_MANIFEST=../front/app/data/photos.json

# Shared with the Nuxt server (NUXT_INTERNAL_API_TOKEN): authenticates redirect / 404 visit counts. Optional.
INTERNAL_API_TOKEN=

# Tag put in the metadata of every Stripe object Mouzoun creates (shared Stripe account)
STRIPE_APP_TAG=
