  "query": "SELECT s.id, s.code::text AS \"code!\", s.color, s.priority, sp.period AS \"period: DateRange\",\n                  COALESCE((SELECT name FROM season_translations WHERE season_id = s.id AND locale = 'fr'), s.code::text) AS \"name!\"\n           FROM seasons s JOIN season_periods sp ON sp.season_id = s.id WHERE sp.period && daterange($1, $2)",
