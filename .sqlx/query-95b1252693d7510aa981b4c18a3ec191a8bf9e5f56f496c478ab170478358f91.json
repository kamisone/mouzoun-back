{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.provider, p.purpose, p.status, p.amount_minor, p.paid_at, p.created_at,\n                  COALESCE((SELECT sum(r.amount_minor) FROM refunds r WHERE r.payment_id = p.id AND r.status = 'succeeded'), 0)::bigint AS \"refunded!\"\n           FROM payments p WHERE p.booking_id = $1 AND p.status NOT IN ('pending', 'cancelled')\n           ORDER BY p.created_at",
