{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.author_name, r.author_country, r.rating, r.title, r.body, r.experience_date, r.locale,\n                  r.booking_id IS NOT NULL AS \"verified!\", r.reply_body, r.created_at\n           FROM reviews r WHERE r.product_id = $1 AND r.status = 'approved'\n           ORDER BY r.is_featured DESC, r.created_at DESC LIMIT 12",
