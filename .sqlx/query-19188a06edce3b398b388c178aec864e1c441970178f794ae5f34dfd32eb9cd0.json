  "query": "SELECT p.id, p.amount_minor, p.failure_reason, p.created_at, b.id AS booking_id, b.reference\n           FROM payments p JOIN bookings b ON b.id = p.booking_id\n           WHERE p.status = 'failed' AND p.created_at > $1 ORDER BY p.created_at DESC LIMIT 20",
