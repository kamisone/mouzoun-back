{
  "db_name": "PostgreSQL",
  "query": "SELECT o.number, o.status, o.payment_status, o.fulfillment_status, o.total_minor, o.currency::text AS \"currency!\", o.placed_at,\n                  (SELECT count(*) FROM order_items WHERE order_id = o.id) AS \"lines!\",\n                  (SELECT product_snapshot->>'image_url' FROM order_items WHERE order_id = o.id ORDER BY sort_order LIMIT 1) AS image_url\n           FROM orders o WHERE o.customer_id = $1 AND o.status <> 'draft' ORDER BY COALESCE(o.placed_at, o.created_at) DESC LIMIT 100",
