{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.number, r.status, r.reason, r.requested_at, o.id AS order_id, o.number AS order_number,\n                  (SELECT COALESCE(sum(quantity), 0) FROM return_items WHERE return_id = r.id)::bigint AS \"items!\", count(*) OVER () AS \"total!\"\n           FROM order_returns r JOIN orders o ON o.id = r.order_id\n           ORDER BY (r.status IN ('requested', 'approved')) DESC, r.requested_at DESC LIMIT $1 OFFSET $2",
