{
  "db_name": "PostgreSQL",
  "query": "SELECT p.provider_payment_id, p.paid_at, p.amount_minor, p.fee_minor, p.net_minor, p.payout_id, p.settled_at, o.number AS \"order_number?\"\n           FROM payments p LEFT JOIN orders o ON o.id = p.order_id\n           WHERE p.provider = 'stripe' AND p.paid_at IS NOT NULL AND (p.paid_at AT TIME ZONE 'Europe/Paris')::date BETWEEN $1 AND $2\n           ORDER BY p.paid_at",
