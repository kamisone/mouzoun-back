{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.number, r.status, r.refund_due_by, r.requested_at, o.id AS order_id, o.number AS order_number\n           FROM order_returns r JOIN orders o ON o.id = r.order_id\n           WHERE r.reason = 'withdrawal' AND r.status NOT IN ('rejected', 'closed') AND r.refund_due_by IS NOT NULL\n           ORDER BY r.refund_due_by LIMIT 100",
