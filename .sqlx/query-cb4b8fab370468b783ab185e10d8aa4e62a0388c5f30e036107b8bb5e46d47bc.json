{
  "db_name": "PostgreSQL",
  "query": "SELECT a.action, a.actor_type, a.changes, a.created_at, u.full_name AS \"by?\"\n           FROM audit_logs a LEFT JOIN users u ON u.id = a.actor_user_id\n           WHERE a.entity_type = 'booking' AND a.entity_id = $1 AND a.action <> 'booking.status_changed'\n           ORDER BY a.created_at DESC LIMIT 100",
