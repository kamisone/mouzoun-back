{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.number, r.status, r.reason, r.customer_note, r.staff_note, r.requested_at, r.received_at,\n                  COALESCE((SELECT jsonb_agg(jsonb_build_object('order_item_id', ri.order_item_id, 'quantity', ri.quantity,\n                            'restock', ri.restock, 'condition', ri.condition)) FROM return_items ri WHERE ri.return_id = r.id), '[]') AS \"items!\"\n           FROM order_returns r WHERE r.order_id = $1 ORDER BY r.requested_at",
