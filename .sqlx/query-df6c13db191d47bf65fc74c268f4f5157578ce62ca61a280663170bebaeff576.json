{
  "db_name": "PostgreSQL",
  "query": "SELECT path, hits, first_seen_at, last_seen_at, last_referrer, is_ignored, count(*) OVER () AS \"total!\"\n           FROM not_found_log\n           WHERE ($1 OR NOT is_ignored) AND ($2::text IS NULL OR path ILIKE '%' || $2 || '%')\n           ORDER BY hits DESC, last_seen_at DESC LIMIT $3 OFFSET $4",
